{
  "git": {
    "deploymentEnabled": {
      "agent/property-stay-time-settings-v1": false,
      "agent/staff-preferred-language-ui-v1": false,
      "agent/stripe-onboarding-status-refresh": false,
      "agent/airbnb-white-label-connection-closure": false,
      "agent/airbnb-callback-persistence-presentation": false,
      "agent/booking-com-white-label-safe": false,
      "agent/booking-com-integrated-closure": false,
      "agent/booking-com-auto-reconcile": false,
      "agent/expedia-connection-center-dashboard": false,
      "agent/mission-control-e13-decoupling-v1": false,
      "agent/calendar-first-mission-control-v1": false,
      "agent/stay-restrictions-removal-ui-v1": false,
      "agent/property-calendar-responsive-v1": false,
      "fix/stay-restrictions-iphone-date-width": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-src 'self' https://app.channex.io https://staging.channex.io https://connect-js.stripe.com https://js.stripe.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/booking/success",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/booking/cancel",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/booking/manage/:guestToken",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": "https://api.pin-ngo.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
